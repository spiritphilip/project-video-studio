# Copy to ~/.video-studio/secrets.env (shared by every project on this PC). Never commit the real file.
# Azure Speech (free F0 tier): portal.azure.com → Speech service → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# ElevenLabs (optional): elevenlabs.io → Profile → API key
ELEVENLABS_API_KEY=
# AI avatar providers (optional, style "real-presenter")
HEYGEN_API_KEY=
DID_API_KEY=
